"""regex_syntax bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "regex-syntax",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "default",
        "std",
        "unicode",
        "unicode-age",
        "unicode-bool",
        "unicode-case",
        "unicode-gencat",
        "unicode-perl",
        "unicode-script",
        "unicode-segment",
    ],
    crate_name = "regex_syntax",
    crate_root = "src/lib.rs",
    edition = "2021",
)

            "third_party/fiat/asm/fiat_curve25519_adx_square.S",
        ],
        ":windows_arm64": [
            "pregenerated/aesv8-armx-win64.S",
            "pregenerated/armv8-mont-win64.S",
            "pregenerated/chacha-armv8-win64.S",
            "pregenerated/chacha20_poly1305_armv8-win64.S",
            "pregenerated/ghash-neon-armv8-win64.S",
            "pregenerated/ghashv8-armx-win64.S",
            "pregenerated/p256-armv8-asm-win64.S",
            "pregenerated/sha256-armv8-win64.S",
            "pregenerated/sha512-armv8-win64.S",
            "pregenerated/vpaes-armv8-win64.S",
        ],
        ":windows_x86_64": [
            "pregenerated/aesni-gcm-x86_64-nasm.o",
            "pregenerated/aesni-x86_64-nasm.o",
            "pregenerated/chacha-x86_64-nasm.o",
            "pregenerated/chacha20_poly1305_x86_64-nasm.o",
            "pregenerated/ghash-x86_64-nasm.o",
            "pregenerated/p256-x86_64-asm-nasm.o",
            "pregenerated/sha256-x86_64-nasm.o",
            "pregenerated/sha512-x86_64-nasm.o",
            "pregenerated/vpaes-x86_64-nasm.o",
            "pregenerated/x86_64-mont-nasm.o",
            "pregenerated/x86_64-mont5-nasm.o",
        ],
        "//conditions:default": [],
    }),
    hdrs = glob([
        "include/**/*.h",
        "crypto/**/*.h",
        "crypto/**/*.inl",
        "third_party/fiat/**/*.h",
    ]) + select({
        ":windows_x86_64": [":windows_prefix_symbols"],
        "//conditions:default": glob(["ring_core_generated/**/*.h"]),
    }),
    copts = [
        "-O3",
        "-fPIC",
        "-fdata-sections",
        "-ffunction-sections",
        "-fno-omit-frame-pointer",
        "-fno-strict-aliasing",
        "-fstack-protector",
        "-fvisibility=hidden",
        "-DNDEBUG",
    ] + select({
        # Forced-include of the prefix-renaming header, which must be the
        # sed-rewritten copy produced by :windows_prefix_symbols and not the
        # one in the source tree.
        #
        # Name it by $(execpath) rather than by a path resolved through -I.
        # The -I form is ambiguous: `includes` puts both this genfiles
        # directory and the package root on the -isystem search path, the
        # package root also contains ring_core_generated/prefix_symbols.h, and
        # Windows builds are unsandboxed so that source copy is visible on
        # disk even though it is not a declared input on this platform. It won
        # the search, so the C sources were compiled with the crate's own
        # ring_core_android_platform_ prefix while the Rust side was told
        # RING_CORE_PREFIX=ring_core_0_17_2_, and every C symbol came out
        # undefined at link time. $(execpath) names one specific file, and
        # because the header is guarded by ring_core_generated_PREFIX_SYMBOLS_H
        # the later #include <ring_core_generated/prefix_symbols.h> in
        # include/ring-core/base.h is then inert whichever copy it finds.
        #
        # This is the form the goldfish netsim_build tree uses (spelled there
        # as the now-deprecated $(location), which expands identically). It
        # failed with C1083 under MSVC cl.exe, which resolves /FI through
        # #include "..." rules and never consults the working directory, but
        # the hermetic toolchain compiles this with clang-cl, which does.
        ":windows_x86_64": ["/FI$(execpath :windows_prefix_symbols)"],
        "//conditions:default": [],
    }),
    data = select({
        ":windows_x86_64": [":windows_prefix_symbols"],
        "//conditions:default": [],
    }),
    includes = select({
        ":windows_x86_64": ["windows_includes"],
        "//conditions:default": [],
    }) + [
        ".",
        "include",
    ],
)

rust_library(
    name = "ring",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/**/*.der"]),
    crate_features = [
        "alloc",
        "default",
        "dev_urandom_fallback",
        "std",
    ],
    crate_name = "ring",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = select({
        ":windows_x86_64": {
            "RING_CORE_PREFIX": "ring_core_0_17_2_",
        },
        "//conditions:default": {
            "RING_CORE_PREFIX": "ring_core_android_platform_",
        },
    }),
    rustc_flags = [
        "--cap-lints=allow",
    ],
    deps = [
        ":libring-core",
        "@getrandom_v0_2",
        "@libc",
        "@spin",
        "@untrusted",
    ],
)

"""tracing-subscriber bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tracing-subscriber",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "default",
        "env-filter",
        "fmt",
        "registry",
        "smallvec",
        "std",
        "tracing-log",
    ],
    crate_name = "tracing_subscriber",
    crate_root = "src/lib.rs",
    edition = "2018",
    deps = [
        "@matchers",
        "@once_cell",
        "@regex-automata",
        "@sharded-slab",
        "@smallvec",
        "@thread_local",
        "@tracing",
        "@tracing-core",
        "@tracing-log",
    ],
)

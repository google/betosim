"""chacha20 bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "chacha20",
    srcs = glob(["**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = [
        "rng",
    ],
    crate_name = "chacha20",
    crate_root = "src/lib.rs",
    edition = "2024",
    deps = [
        "@cfg-if",
        "@rand_core",
    ] + select({
        "@platforms//cpu:x86_32": ["@cpufeatures"],
        "@platforms//cpu:x86_64": ["@cpufeatures"],
        "//conditions:default": [],
    }),
)

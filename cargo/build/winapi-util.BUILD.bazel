"""winapi_util bazel build rule

Only reachable on Windows, where termcolor uses winapi_util::console for the
legacy console colour API. The crate itself compiles to an empty library on
other platforms, but nothing depends on it there.
"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "winapi-util",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "Win32_System_Console",
    ],
    crate_name = "winapi_util",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = select({
        "@bazel_tools//src/conditions:windows": ["@windows-sys"],
        "//conditions:default": [],
    }),
)

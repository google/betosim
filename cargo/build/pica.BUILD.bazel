"""pica bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

genrule(
    name = "pica_uci_packets",
    srcs = ["src/uci_packets.pdl"],
    outs = ["uci_packets.rs"],
    cmd = "$(execpath @pdl-compiler//:pdlc) --output-format rust $(SRCS) > $(OUTS)",
    tools = ["@pdl-compiler//:pdlc"],
)

rust_library(
    name = "pica",
    srcs = glob(["src/**/*.rs"]) + [
        ":pica_uci_packets",
    ],
    crate_name = "pica",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_env = {"OUT_DIR": ".."},
    deps = [
        "@bytes",
        "@futures",
        "@hex",
        "@parking_lot",
        "@pdl-runtime",
        "@serde",
        "@thiserror",
        "@tokio",
        "@tracing",
    ],
)

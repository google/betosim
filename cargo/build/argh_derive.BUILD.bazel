"""argh_derive bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "argh_derive",
    srcs = glob(["**/*.rs"]),
    crate_name = "argh_derive",
    crate_root = "src/lib.rs",
    edition = "2018",
    deps = [
        "@argh_shared",
        "@proc-macro2",
        "@quote",
        "@syn",
    ],
)

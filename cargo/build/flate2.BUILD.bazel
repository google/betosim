"""flate2 bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "flate2",
    srcs = glob(["**/*.rs"]),
    compile_data = ["README.md"],
    crate_features = [
        "any_impl",
        "any_zlib",
        "libz-rs-sys",
        "zlib-rs",
    ],
    crate_name = "flate2",
    crate_root = "src/lib.rs",
    edition = "2018",
    deps = [
        "@crc32fast",
        "@zlib-rs",
    ],
)

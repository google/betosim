"""num_bigint bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "num-bigint",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "default",
        "std",
    ],
    crate_name = "num_bigint",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@num-integer",
        "@num-traits",
    ],
)

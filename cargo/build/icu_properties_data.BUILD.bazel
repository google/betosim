"""icu_properties_data bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "icu_properties_data",
    srcs = glob(["**/*.rs"]),
    # The generated data modules are pulled in with include!(), so the
    # .rs.data files must be available to rustc even though they are not
    # crate sources.
    compile_data = glob(["**/*.rs.data"]),
    crate_name = "icu_properties_data",
    crate_root = "src/lib.rs",
    edition = "2021",
)

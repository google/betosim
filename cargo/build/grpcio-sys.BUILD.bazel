"""grpcio-sys bazel build rule"""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

# gRPC 1.81 removed gpr_set_log_function/gpr_set_log_verbosity, GPR_ASSERT,
# and the transitive grpc/credentials.h include. Upstream grpcio-sys 0.13 and
# grpcio 0.13 still reference them (in-tree AOSP patched those files directly),
# so provide no-op log symbols and force-include the headers/assert macro here.
cc_library(
    name = "grpc_wrap_deps",
    srcs = [
        "grpc_wrap.cc",
        "@netsim//cargo/build:grpc_log_shim.cc",
    ],
    copts = select({
        "@platforms//os:windows": [
            "/FIgrpc/credentials.h",
            "/FIassert.h",
            "-DGPR_ASSERT=assert",
            "/wd4005",
            "-Wno-macro-redefined",
        ],
        "//conditions:default": [
            "-include",
            "grpc/credentials.h",
            "-include",
            "assert.h",
            "-DGPR_ASSERT=assert",
            "-Wno-macro-redefined",
        ],
    }),
    deps = [
        "@grpc//:grpc++",
    ],
    alwayslink = True,
)

rust_library(
    name = "grpcio-sys",
    srcs = [
        "bindings/bindings.rs",
        "src/grpc_wrap.rs",
        "src/lib.rs",
    ],
    crate_features = [
        "_libz-sys",
        "_secure",
        "boringssl",
        "boringssl-src",
        "libz-sys",
    ],
    crate_name = "grpcio_sys",
    crate_root = "src/lib.rs",
    edition = "2018",
    rustc_env = {
        "BINDING_PATH": "../bindings/bindings.rs",
    },
    deps = [
        ":grpc_wrap_deps",
        "@libc",
        "@libz-sys",
    ],
)

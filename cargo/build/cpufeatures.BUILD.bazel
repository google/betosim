"""cpufeatures bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cpufeatures",
    srcs = glob(["**/*.rs"]),
    compile_data = ["README.md"],
    crate_name = "cpufeatures",
    edition = "2021",
    deps = select({
        "@platforms//os:macos": ["@libc"],
        "//conditions:default": [],
    }),
)

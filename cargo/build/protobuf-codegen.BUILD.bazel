"""protobuf-codegen bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "protobuf_codegen",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "protobuf_codegen",
    edition = "2021",
    deps = [
        "@anyhow",
        "@once_cell",
        "@protobuf-parse",
        "@protobuf-rust",
        "@protobuf-support",
        "@regex",
        "@tempfile",
        "@thiserror",
    ],
)

rust_binary(
    name = "protoc-gen-rust",
    srcs = ["src/bin/protoc-gen-rs.rs"],
    edition = "2021",
    deps = [
        ":protobuf_codegen",
        "@protobuf-rust",
    ],
)

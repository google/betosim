"""clap bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "clap",
    srcs = glob(["**/*.rs"]),
    compile_data = ["examples/demo.md"],
    crate_features = [
        "derive",
        "env",
        "error-context",
        "help",
        "std",
        "string",
        "usage",
    ],
    crate_name = "clap",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@clap_derive",
    ],
    deps = [
        "@clap_builder",
    ],
)

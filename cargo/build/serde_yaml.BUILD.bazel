"""serde_yaml bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "serde_yaml",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "serde_yaml",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_flags = [
        "--cap-lints=allow",
    ],
    deps = [
        "@indexmap",
        "@itoa",
        "@ryu",
        "@serde",
        "@unsafe-libyaml",
    ],
)

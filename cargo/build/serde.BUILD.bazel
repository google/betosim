"""serde bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "serde",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "default",
        "derive",
        "rc",
        "serde_derive",
        "std",
    ],
    crate_name = "serde",
    crate_root = "src/lib.rs",
    data = ["out/private.rs"],
    edition = "2021",
    proc_macro_deps = ["@serde_derive"],
    rustc_env = {"OUT_DIR": "../out"},
    deps = ["@serde_core"],
)

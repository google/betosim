"""protobuf-rust bazel build rule"""

load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    edition = "2021",
    version = "3.7.2",
)

rust_library(
    name = "protobuf-rust",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "bytes",
    ],
    crate_name = "protobuf",
    edition = "2021",
    deps = [
        ":build_script",
        "@bytes",
        "@once_cell",
        "@protobuf-support",
        "@thiserror",
    ],
)

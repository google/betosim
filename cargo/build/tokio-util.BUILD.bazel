"""tokio_util bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tokio-util",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "codec",
        "compat",
        "full",
        "futures-io",
        "futures-util",
        "hashbrown",
        "io",
        "io-util",
        "join-map",
        "net",
        "rt",
        "slab",
        "time",
    ],
    crate_name = "tokio_util",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@bytes",
        "@futures-core",
        "@futures-io",
        "@futures-sink",
        "@futures-util",
        "@hashbrown",
        "@pin-project-lite",
        "@slab",
        "@tokio",
    ],
)

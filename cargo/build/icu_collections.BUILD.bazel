"""icu_collections bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "icu_collections",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
    ],
    crate_name = "icu_collections",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@displaydoc",
    ],
    deps = [
        "@potential_utf",
        "@utf8_iter",
        "@yoke",
        "@zerofrom",
        "@zerovec",
    ],
)

"""hyper-util bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "hyper-util",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "client",
        "client-legacy",
        "client-pool",
        "client-proxy",
        "full",
        "http1",
        "http2",
        "server",
        "server-auto",
        "server-graceful",
        "service",
        "tokio",
        "tracing",
    ],
    crate_name = "hyper_util",
    crate_root = "src/lib.rs",
    edition = "2024",
    rustc_flags = [
        # Suppress new lints introduced by Rust 1.91.1.
        "--cap-lints=allow",
    ],
    deps = [
        "@base64",
        "@bytes",
        "@futures-channel",
        "@futures-util",
        "@http",
        "@http-body",
        "@httparse",
        "@hyper",
        "@ipnet",
        "@libc",
        "@percent-encoding",
        "@pin-project-lite",
        "@socket2",
        "@tokio",
        "@tower-layer",
        "@tower-service",
        "@tracing",
    ],
)

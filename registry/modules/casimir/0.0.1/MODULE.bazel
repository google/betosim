module(
    name = "casimir",
    version = "0.0.1",
)

bazel_dep(name = "rules_rust", version = "0.69.0")
bazel_dep(name = "netsim", version = "0.0.1")

lrc = use_extension("@netsim//cargo:local_rust_crates.bzl", "lrc")
use_repo(
    lrc,
    "anyhow",
    "argh",
    "bytes",
    "command-fds",
    "env_logger",
    "futures",
    "log",
    "pdl-compiler",
    "pdl-runtime",
    "tokio",
)

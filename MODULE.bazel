# Needed by @pdl-compiler's BUILD, which uses py_binary for the C++ PDL
# generator. Repos created by the lrc extension resolve labels through this
# module's repo mapping, so rules_python has to be a direct dependency here.
# This matches the version already resolved transitively, so declaring it here
# does not change resolution.
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "rules_foreign_cc", version = "0.13.0")
bazel_dep(name = "protobuf", version = "33.5")
bazel_dep(name = "boringssl", version = "0.20251124.0")

bazel_dep(name = "glib", version = "2.82.2.bcr.5.aemu", dev_dependency = True)

bazel_dep(name = "cxx.rs", version = "1.0.175")
single_version_override(
    module_name = "cxx.rs",
    patch_strip = 1,
    patches = ["//cargo/build:cxx.patch"],
)

# repo_name override needed by @grpc
bazel_dep(name = "protoc-gen-validate", version = "1.3.0", repo_name = "com_envoyproxy_protoc_gen_validate")
bazel_dep(name = "grpc", version = "1.81.1")
single_version_override(
    module_name = "grpc",
    patch_strip = 1,
    patches = [
        "//cargo/build:grpc_aemu_no-macos-universal-binary.patch",
        "//cargo/build:grpc_null-function-check.patch",
    ],
)

bazel_dep(name = "c-ares", version = "1.34.6")

# @rootcanal's BUILD file depends on @fmt, resolved through netsim's repo
# mapping. fmt 11.x does not compile against the toolchain's libc++ because
# fmt/format.h defines _LIBCPP_REMOVE_TRANSITIVE_INCLUDES and uses
# malloc()/free() without including <cstdlib>; 12.0.0 is the first release
# that includes <cstdlib>.
bazel_dep(name = "fmt", version = "12.0.0")
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "grpc-java", version = "1.82.0")

# Hermetic C/C++ toolchain.
#
# Building with whatever compiler happens to be installed on the build machine
# turned out to be very brittle. macOS picked up the bot's Xcode 14.3 libc++
# (needing cargo/build/cxx.patch), and Windows fell back to MSVC cl.exe instead
# of clang-cl, which silently ignored -std=c++20, could not resolve /FI paths
# relative to the execroot, and rejected the clang-style -Wno-* flags used by
# third-party BUILD files this project does not own. The hermetic toolchain
# eliminates that entire class of problem.
#
# The extension only reads tags from the root module, so both the version_file
# and clang tags have to be declared here rather than inherited.
#
# TODO: goldfish_build carries much more than the cc toolchain. Extract
# //toolchains/cc, //extensions:toolchain.bzl and //rules:overlay_repository.bzl
# into a standalone registry module so netsim can depend on the toolchain alone
# and drop the rest of the emulator build.
bazel_dep(name = "goldfish_build", version = "0.0.3", dev_dependency = True)

custom_toolchains = use_extension("@goldfish_build//extensions:toolchain.bzl", "toolchain", dev_dependency = True)
custom_toolchains.version_file(
    label = "@goldfish_build//toolchains:tool_versions.json",
)

# new_local_repository resolves a relative path against this workspace root
# (tools/netsim), but the compiler prebuilts live at the Android tree root.
custom_toolchains.clang(root_path = "../../prebuilts/clang/host")

# The cc toolchains above require `@bazel_tools//tools/cpp:clang` in
# exec_compatible_with. Bazel's default host platform does not declare a
# cc_compiler constraint, so without this the hermetic toolchain never matches
# and resolution silently falls back to the autodetected host compiler. This
# repo maps the detected host onto the matching goldfish platform, and
# .bazelrc points --host_platform at it.
host_platform_repository = use_repo_rule("@goldfish_build//platforms:host_platform.bzl", "host_platform_repository")

host_platform_repository(
    name = "host_platform",
    dev_dependency = True,
    host = {
        '{"os": "linux", "arch": "x64"}': "@goldfish_build//platforms:linux_x64",
        '{"os": "macos", "arch": "x64"}': "@goldfish_build//platforms:macos_x64",
        '{"os": "macos", "arch": "arm64"}': "@goldfish_build//platforms:macos_aarch64",
        '{"os": "windows", "arch": "x64"}': "@goldfish_build//platforms:windows_x64",
    },
)

# The Linux cc toolchain links against the glibc 2.17 sysroot from
# prebuilts/gcc. The extension hardcodes that path workspace-relative, which
# only resolves when the Bazel workspace is the Android tree root; here it
# would resolve under tools/netsim. The repo rule is declared not_found_ok, so
# it silently yields an empty repo and the failure only surfaces much later as
# "missing input file .../sysroot/usr/lib/libc.so.6". Recreate the repo with a
# path relative to this workspace and substitute it.
#
# TODO: make the sysroot path a tag attribute upstream so this override can go
# away; it is the same workspace-root assumption that must be fixed anyway
# before the toolchain can live in its own repository.
overlay_repository = use_repo_rule("@goldfish_build//rules:overlay_repository.bzl", "overlay_repository")

overlay_repository(
    name = "netsim_gcc_lib",
    dev_dependency = True,
    overlay_files = {"BUILD.bazel": "@goldfish_build//toolchains/cc/linux_clang:gcc_lib.BUILD"},
    path = "../../prebuilts/gcc/linux-x86/host/x86_64-linux-glibc2.17-4.8",
)

# gcc_lib.BUILD declares visibility to these extension-generated repos, so they
# must be visible here for the overlaid BUILD file to load.
use_repo(custom_toolchains, "clang_linux_x64", "toolchain_hub")

override_repo(
    custom_toolchains,
    gcc_lib = "netsim_gcc_lib",
)

# Rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    extra_target_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
    ],
    rustfmt_version = "1.94.1",
    versions = ["1.94.1"],
)

